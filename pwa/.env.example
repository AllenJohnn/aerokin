# AEROKIN PWA Client Environment Configuration

# Optional: Force hosted mode regardless of domain name.
# By default, the PWA auto-detects hosted mode (returns true for public web domains like vercel.app,
# and returns false for LAN IP addresses, localhost, and .local mDNS names).
VITE_HOSTED_MODE=false

# Optional: PC Agent HTTPS port for local development when running Vite on port 5173/5174.
# Defaults to 8443.
VITE_DEV_SERVER_PORT=8443

# Optional: Custom output directory for Vite builds.
# Defaults to ../server/public for local agent-served flow, and dist for hosted static deployments.
AEROKIN_OUT_DIR=dist
