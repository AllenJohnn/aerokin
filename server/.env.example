# AEROKIN PC Agent Environment Configuration

# Comma-separated list of allowed HTTPS origins for Cross-Site WebSocket Hijacking (CSWSH) protection.
# The agent's own local LAN IP, mDNS (aerokin.local), and loopback (localhost) are always allowed automatically.
# Add your hosted PWA origin here (e.g. https://your-app.vercel.app).
AEROKIN_ALLOWED_ORIGINS=https://aerokin.vercel.app

# Optional: URL of your hosted static PWA deployment (e.g. on Vercel or Netlify).
# When set, the PC agent prints a 3rd QR code and pairing link using the secure URL fragment format:
# https://aerokin.vercel.app/#host=192.168.1.50:8443&code=4EA378
AEROKIN_HOSTED_URL=https://aerokin.vercel.app
