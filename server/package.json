{
  "name": "aerokin-server",
  "version": "1.0.0",
  "description": "AEROKIN WebSocket + HTTPS input automation server for Windows",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "trust": "tsx src/trust.ts",
    "test:input": "tsx scripts/test-input.ts",
    "test:media": "tsx scripts/test-media.ts",
    "bench:desktop": "tsx scripts/desktop-bench.ts",
    "bench:soak": "tsx scripts/soak-test.ts",
    "capture:check": "tsx scripts/capture-check.ts",
    "spike:h264": "tsx scripts/h264-spike.ts",
    "safety:check": "node ../scripts/safety-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "bonjour-service": "^1.4.4",
    "express": "^4.21.2",
    "koffi": "^3.3.6",
    "node-datachannel": "^0.33.6",
    "node-forge": "^1.4.2",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "sharp": "^0.33.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
