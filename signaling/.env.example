# ==============================================================================
# AEROKIN Remote Infrastructure Environment Configuration
# ==============================================================================

# VPS Public IPv4 address (e.g. 203.0.113.10)
EXTERNAL_IP=203.0.113.10

# Domain for automatic TLS termination via Caddy
AEROKIN_SIGNALING_DOMAIN=signaling.yourdomain.com

# Public hostname/IP for STUN/TURN traffic
COTURN_HOST=turn.yourdomain.com

# Shared secret key used for HMAC-SHA1 coturn authentication
# Generate with: openssl rand -hex 32
COTURN_SECRET=change-this-to-a-secure-random-hex-string-for-production

# Authentication realm (matches domain)
COTURN_REALM=yourdomain.com
