# ==============================================================================
# AEROKIN Remote Infrastructure Environment Variables (.env)
# Copy this template to .env and populate with your own VPS secrets:
#   cp deploy/.env.example .env
#
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# Generate strong secrets with:
#   ./scripts/generate-secrets.sh   (Linux/macOS)
#   .\scripts\generate-secrets.ps1 (Windows PowerShell)
# ==============================================================================

# 1. Coturn & Signaling Shared Secret (MUST be a random 32+ character hex string)
TURN_SECRET=REPLACE_WITH_GENERATED_32_BYTE_HEX_SECRET

# 2. Public DNS / Hostnames (Pointing to your VPS IP)
AEROKIN_SIGNALING_DOMAIN=signal.yourdomain.com
COTURN_HOST=turn.yourdomain.com
TURN_REALM=turn.yourdomain.com

# 3. Public IPv4 of your VPS (Required for Coturn NAT traversal)
EXTERNAL_IP=203.0.113.1

# 4. Allowed Origins (Comma-separated HTTPS origins permitted to connect to signaling)
ALLOWED_ORIGINS=https://app.yourdomain.com,https://localhost:8080

# 5. Optional Port Overrides
PORT=8088
COTURN_UDP_PORT=3478
COTURN_TCP_PORT=3478
COTURN_TLS_PORT=5349
