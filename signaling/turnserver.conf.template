# ==============================================================================
# AEROKIN Self-Hosted Coturn STUN/TURN Configuration Template
# ==============================================================================

# Standard STUN/TURN listening ports
listening-port=3478
tls-listening-port=5349

# Standard ephemeral WebRTC relay port range
min-port=49152
max-port=65535

# Require standard WebRTC message integrity fingerprints
fingerprint

# Use long-term credential mechanism and REST API shared-secret auth
lt-cred-mech
use-auth-secret

# Shared secret and realm (template variables replaced at deployment)
static-auth-secret=${TURN_SECRET}
realm=${TURN_REALM}

# Security hardening: Prevent loopback, multicast, and private peer connections
no-loopback-peers
no-multicast-peers
no-cli

# RFC 1918, RFC 5737, RFC 6598, RFC 3927 denied peer IP ranges (prevent SSRF/LAN pivot)
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Quotas and session limits
total-quota=100
user-quota=12
stale-nonce=600

# Logging
verbose
log-file=stdout
